# GrowPocket 后端环境变量配置示例
# 复制本文件为 .env 并填入实际值即可

# 服务端口
PORT=8080

# 数据库文件路径
DB_PATH=./data/growpocket.db

# 上传文件目录
UPLOAD_DIR=./uploads

# JWT 密钥（生产环境务必修改）
JWT_SECRET=growpocket-secret-key-change-in-production

# JWT 有效期（小时）
JWT_DURATION_HOUR=2

# ============ AI 配置 ============
# AI 服务 API Key（必填，否则 AI 功能不可用）
AI_API_KEY=

# AI 模型名（默认 deepseek-chat）
AI_MODEL=deepseek-chat

# AI 服务地址（默认 DeepSeek 官方）
# 切换 OpenAI: https://api.openai.com/v1
# 切换通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=https://api.deepseek.com/v1

# ============ 管理后台配置 ============
# 管理后台 JWT 密钥（生产环境务必修改，与前端 JWT_SECRET 区分开）
ADMIN_JWT_SECRET=growpocket-admin-secret-key-change-in-production

# 管理后台 JWT 有效期（小时）
ADMIN_JWT_EXPIRE_HOUR=12

# 管理后台初始管理员密码（首次启动自动创建后建议删除该变量或在后台修改密码）
ADMIN_INIT_PASSWORD=admin123456

# 管理后台 IP 白名单（逗号分隔，留空表示不限制；如: 192.168.1.0/24,10.0.0.1）
ADMIN_IP_WHITELIST=
